# Copy this file to .env.test and fill in real values.
# .env.test is git-ignored — never commit real credentials.

BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/school_nexus_test
API_SECRET=<your_test_api_secret>
ADMIN_EMAIL=<admin_email>
ADMIN_PASSWORD=<admin_password>
TEACHER_EMAIL=<teacher_email>
TEACHER_PASSWORD=<teacher_password>
STUDENT_EMAIL=<student_email>
STUDENT_PASSWORD=<student_password>

# ─────────────────────────────────────────────────────────────────────────────
# WhatsApp Business API (Meta Cloud API)
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
# ─────────────────────────────────────────────────────────────────────────────

# Required: The Phone Number ID from Meta Business Manager
# Found at: Meta Developer Console → Your App → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=<your_phone_number_id>

# Required: Permanent system-user access token (never use a short-lived token in production)
# Generate at: Meta Business Manager → System Users → Generate Token
WHATSAPP_ACCESS_TOKEN=<your_permanent_access_token>

# Optional: Token used to verify the Meta webhook endpoint (GET /api/whatsapp/webhook)
# Set this to any random string and configure the same value in Meta Developer Console
WHATSAPP_WEBHOOK_VERIFY_TOKEN=<your_webhook_verify_token>

# Optional: Meta Graph API version (default: v19.0)
# Check https://developers.facebook.com/docs/graph-api/changelog for latest stable version
WHATSAPP_API_VERSION=v19.0

# Optional: Public base URL of this app (used for PDF links in WhatsApp messages)
# Must be publicly accessible — use ngrok or similar for local development
APP_URL=http://localhost:5000
